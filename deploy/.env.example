# CooLRouter — environment template.
#
#   cp deploy/.env.example .env      then fill in only what you actually use.
#
# The router reads this file from its parent directory at startup. A key that is absent or empty
# simply disables the leg that needs it — no leg, no crash. No secret belongs in this repository.

# ── cloud legs (optional) ────────────────────────────────────────────────────────────────
# The flash tier tries its legs in order and stops at the first one that answers.
OPENCODE_ZEN_API_KEY=          # primary subscription leg
OPENCODE_GO_API_KEY=           # fallback subscription leg
NVIDIA_API_KEY=                # free backup leg, used by the vision tier
PERPLEXITY_API_KEY=            # research tier
OPENROUTER_API_KEY=            # optional; the classifier's escalation check

# ── local tier (optional) ────────────────────────────────────────────────────────────────
# Any OpenAI-compatible Ollama endpoint. Defaults shown; unset means "use the default".
ROUTER_OLLAMA_URL=http://127.0.0.1:11434
ROUTER_LOCAL_MODEL=gemma3:4b
ROUTER_LOCAL_VISION_MODEL=hf.co/unsloth/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M
